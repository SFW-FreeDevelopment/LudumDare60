<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure simulation: no KNI / MonoGame types, no platform APIs. Everything here is deterministic
       and unit-testable, and it is the only place game rules live. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Balloonatic.Core</RootNamespace>
    <AssemblyName>Balloonatic.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
