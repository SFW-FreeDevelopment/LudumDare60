<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsTrimmable Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsTrimmable>
    <ProjectGuid>3C51DFF7-E350-4E21-A81C-8D37CEDEA988</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>Balloonatic</RootNamespace>
    <AssemblyName>Balloonatic.Game</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="nkast.Xna.Framework" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Content" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Audio" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Media" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Input" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Game" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Devices" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.Storage" Version="4.3.9001" />
    <PackageReference Include="nkast.Xna.Framework.XR" Version="4.3.9001" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Balloonatic.Core\Balloonatic.Core.csproj" />
  </ItemGroup>

  <!-- Sprite sheet built by art/.art (Aseprite MCP). Embedded so the desktop head and the WASM
       head read the same bytes through the same stream — no platform file loading. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\art\export\sheet.png" Link="content\sheet.png" />
    <EmbeddedResource Include="..\..\art\export\slices.json" Link="content\slices.json" />
  </ItemGroup>

  <!-- Audio kit built by audio/.audio (same philosophy: one generator, reproducible bytes,
       logical names stable across heads). 11.025 kHz mono keeps the whole kit at ~330 KB raw. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\audio\export\*.wav">
      <LogicalName>Balloonatic.content.audio.%(Filename).wav</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
